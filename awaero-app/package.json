  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:sim": "expo run:ios --configuration Release --no-bundler -d C2C1E3CF-DEA2-44DC-9979-F305F708E7CA",
    "ios:phone": "cd ios && xcodebuild -workspace Awaero.xcworkspace -scheme Awaero -configuration Release -destination 'id=00008150-00021CC836F3C01C' -derivedDataPath build -allowProvisioningUpdates build && cd build/Build/Products/Release-iphoneos && xcrun devicectl device install app --device 00008150-00021CC836F3C01C Awaero.app",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
